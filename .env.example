# UrbanSage AI — Environment Variable Template
# Copy this file to .env and fill in your values.
# Never commit the .env file to version control.

# --- Application ---
APP_ENV=development          # development | staging | production
LOG_LEVEL=INFO

# --- Backend API ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Primary Database (Supabase PostgreSQL) ---
# DATABASE_BACKEND defaults to "supabase" in production.
DATABASE_BACKEND=supabase
SUPABASE_URL=https://your-project-ref.supabase.co
# Server-side secret key (supports new 'sbp_...' format or legacy service_role JWT key)
# NEVER expose this key to the frontend or browser!
SUPABASE_SECRET_KEY=your-supabase-secret-or-service-role-key

# --- Local Development / Offline Testing Option ---
# To run offline without Supabase credentials during isolated testing:
# DATABASE_BACKEND=sqlite
# REPORTS_DB_PATH=urbansage_reports.db

# --- AWS (Stage 8) ---
# AWS_REGION=ap-south-1
# AWS_S3_BUCKET_NAME=urbansage-scenario-artefacts
# AWS_ACCESS_KEY_ID=your-access-key-id
# AWS_SECRET_ACCESS_KEY=your-secret-access-key

# --- Amazon Bedrock (Stage 6, optional) ---
# BEDROCK_REGION=us-east-1
# BEDROCK_MODEL_ID=anthropic.claude-3-sonnet-20240229-v1:0
